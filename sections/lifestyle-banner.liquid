<section class="lifestyle-banner">
  <div class="page-width lifestyle-banner__inner">
    <div class="lifestyle-banner__media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="900" height="900">
      {% else %}
        <img src="{{ 'lifestyle-samosa.jpg' | asset_url }}" alt="Ghost Chutney served with hot samosas" loading="lazy" width="900" height="900">
      {% endif %}
    </div>
    <div class="lifestyle-banner__content">
      <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="lifestyle-banner__heading">{{ section.settings.heading }}</h2>
      <p class="lifestyle-banner__text">{{ section.settings.text }}</p>
      <a href="{{ section.settings.link }}" class="btn btn--solid">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From Our Kitchen" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight from the jar to your plate" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ghost Chutney, hot samosas, and nothing else needed. That's the whole recipe." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Ghost Chutney" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the Ghost Chutney + samosa lifestyle photo" }
  ],
  "presets": [
    { "name": "Lifestyle banner" }
  ]
}
{% endschema %}
