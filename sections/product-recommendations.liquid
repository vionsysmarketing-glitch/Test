{% comment %}
  Uses Shopify's built-in recommendation engine (routes.product_recommendations_url)
  rather than the Search & Discovery app's "Related products" block — that app
  block renders with its own markup/classes that this theme has no control
  over, which is why it showed up unstyled. This section is fetched and
  swapped in by initProductRecommendations() in theme.js once Shopify returns
  results, same async pattern Shopify's own reference themes use. Empty until
  JS populates it — that's expected, not a bug.
{% endcomment %}
<div
  class="product-recs"
  id="ProductRecommendations-{{ section.id }}"
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <div class="page-width">
      <div class="section-heading">
        <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
      <div class="product-recs__grid">
        {% for recommended_product in recommendations.products %}
          <a href="{{ recommended_product.url }}" class="product-recs__card">
            <div class="product-recs__media">
              {% if recommended_product.featured_image %}
                <img src="{{ recommended_product.featured_image | image_url: width: 400 }}" alt="{{ recommended_product.featured_image.alt | escape }}" width="400" height="400" loading="lazy">
              {% endif %}
            </div>
            <h3 class="product-recs__title">{{ recommended_product.title }}</h3>
            <div class="product-recs__price-row">
              <span class="product-recs__price">{{ recommended_product.price | money }}</span>
              {% if recommended_product.compare_at_price > recommended_product.price %}
                <span class="product-recs__price-compare">{{ recommended_product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete The Pantry" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "default": 4, "label": "Products to show" }
  ]
}
{% endschema %}
