{% comment %} Hardcoded — see scroll-showcase.liquid for why. {% endcomment %}
<section class="testimonials">
  <div class="page-width testimonials__inner">
    <div class="testimonials__trust">
      <span class="testimonials__badge">🦖 Loved by spice-seekers</span>
      <h2 class="testimonials__count">{{ section.settings.count }}<span class="testimonials__plus">+</span></h2>
      <p class="testimonials__count-sub">{{ section.settings.count_label }}</p>
      <p class="testimonials__tagline">{{ section.settings.tagline }}</p>
      <div class="testimonials__avatars" aria-hidden="true">
        {% for i in (1..5) %}<span class="testimonials__avatar testimonials__avatar--{{ i }}"></span>{% endfor %}
      </div>
    </div>

    <div class="testimonials__grid">
      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">&ldquo;The Ghost Chutney lives up to its name. Absolutely addictive on everything.&rdquo;</p>
        <footer class="testimonial-card__author">— Priya S.</footer>
      </blockquote>
      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">&ldquo;Finally, a momo chutney that tastes like the street cart back home.&rdquo;</p>
        <footer class="testimonial-card__author">— Arjun M.</footer>
      </blockquote>
      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">&ldquo;The garam masala completely changed my dal. So much more aromatic.&rdquo;</p>
        <footer class="testimonial-card__author">— Fatima K.</footer>
      </blockquote>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "count", "label": "Customer count", "default": "12,000" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "happy taste buds and counting" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Real people. Real heat. Real cravings." }
  ]
}
{% endschema %}
