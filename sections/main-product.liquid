<section class="product-page page-width">
  <div class="product-page__media">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="800">
    {% else %}
      <div class="product-row__media-placeholder">{{ product.title }}</div>
    {% endif %}
    {% if product.images.size > 1 %}
      <div class="product-page__thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" width="150" height="150">
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-page__info">
    <h1 class="product-page__title">{{ product.title }}</h1>
    <p class="product-page__price">{{ product.price | money }}</p>
    <div class="product-page__description">{{ product.description }}</div>

    {% form 'product', product %}
      {% unless product.has_only_default_variant %}
        <select name="id" class="product-page__variant-select">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
              {{ variant.title }} — {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      <button type="submit" class="btn btn--solid" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
