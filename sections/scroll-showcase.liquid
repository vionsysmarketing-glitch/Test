{% comment %}
  Products are hardcoded directly here rather than driven by schema "default"
  blocks. Shopify's default-block population proved unreliable in practice for
  this section, silently rendering zero blocks with no error — hardcoding
  removes that failure mode entirely. Settings (eyebrow/heading) stay editable.
{% endcomment %}
{% assign p_titles = 'Ghost Chutney|Imli Chutney|Momo Chutney|Chilli Flakes|Garam Masala Powder|Coriander Powder' | split: '|' %}
{% assign p_taglines = 'For the heat-seekers|Ghar wali meethi chutney|The dip that made momos famous|Export quality, sun-dried heat|The soul of every curry|Fresh-ground, never stale' | split: '|' %}
{% assign p_light = '#F7C9C2|#F3DFAE|#F7C2B8|#E8E2DC|#E4D2BE|#DCE8CC' | split: '|' %}
{% assign p_dark = '#9D0101|#B5651D|#9D0101|#4A4A4A|#5C3A21|#4A6B1F' | split: '|' %}
{% assign p_images = 'ghost-chutney.jpg|imli-chutney.jpg|momo-chutney.jpg|chilli-flakes.jpg|garam-masala.jpg|coriander-powder.jpg' | split: '|' %}

{% capture colors_json %}[{% for title in p_titles %}{"light":"{{ p_light[forloop.index0] }}","dark":"{{ p_dark[forloop.index0] }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}

<section
  class="scroll-showcase"
  id="ScrollShowcase"
  data-scroll-showcase
  style="--bg-left: {{ p_light[0] }}; --bg-right: {{ p_dark[0] }};"
  data-colors='{{ colors_json | strip_newlines | strip }}'
>
  <div class="page-width">
    <div class="section-heading">
      <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="scroll-showcase__track" id="ScrollShowcaseTrack">
    <div class="scroll-showcase__sticky">
      <div class="scroll-showcase__bg" aria-hidden="true"></div>
      <div class="scroll-showcase__inner page-width">

        <div class="scroll-showcase__text">
          {% for title in p_titles %}
            {% assign i = forloop.index0 %}
            <div class="scroll-showcase__panel{% if forloop.first %} is-active{% endif %}" data-slide="{{ i }}">
              <h3 class="scroll-showcase__title" style="color: {{ p_dark[i] }};">{{ title }}</h3>
              <p class="scroll-showcase__tagline">{{ p_taglines[i] }}</p>
              {% case title %}
                {% when 'Ghost Chutney' %}
                  <p class="scroll-showcase__desc">Sil-batta prepared with real ghost pepper, garlic and slow-roasted tomato. Homemade-style, no shortcuts, no mercy.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Made with real ghost peppers</li>
                    <li>{% render 'icon-check' %}Zero preservatives</li>
                    <li>{% render 'icon-check' %}Ready to eat, straight from the jar</li>
                  </ul>
                {% when 'Imli Chutney' %}
                  <p class="scroll-showcase__desc">A tangy tamarind chutney that balances sweet jaggery with a citrusy punch. The one that goes with everything.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Hyperlocal tamarind & jaggery</li>
                    <li>{% render 'icon-check' %}No artificial flavours</li>
                    <li>{% render 'icon-check' %}Perfect with snacks, chaat & momos</li>
                  </ul>
                {% when 'Momo Chutney' %}
                  <p class="scroll-showcase__desc">Fiery, garlicky and a little smoky — the classic street-style momo dip, jarred for your fridge.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Street-style spice blend</li>
                    <li>{% render 'icon-check' %}Small-batch roasted</li>
                    <li>{% render 'icon-check' %}Goes beyond momos: fries, eggs, rice</li>
                  </ul>
                {% when 'Chilli Flakes' %}
                  <p class="scroll-showcase__desc">Crushed sun-dried red chillies with a smoky crunch. Sprinkle it on pizza, pasta, eggs — anything that needs a kick.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Export-quality sun-dried chillies</li>
                    <li>{% render 'icon-check' %}No fillers, no colouring</li>
                    <li>{% render 'icon-check' %}Coarse crunch, bold heat</li>
                  </ul>
                {% when 'Garam Masala Powder' %}
                  <p class="scroll-showcase__desc">A warm, aromatic blend of roasted whole spices ground fresh. One spoon transforms any dal, sabzi or curry.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Small-batch roasted & ground</li>
                    <li>{% render 'icon-check' %}No anti-caking agents</li>
                    <li>{% render 'icon-check' %}Export-quality spice sourcing</li>
                  </ul>
                {% when 'Coriander Powder' %}
                  <p class="scroll-showcase__desc">Earthy, citrusy coriander powder ground from export-quality seeds. The everyday base note for Indian cooking.</p>
                  <ul class="scroll-showcase__benefits">
                    <li>{% render 'icon-check' %}Export-quality coriander seeds</li>
                    <li>{% render 'icon-check' %}Ground fresh, not stockpiled</li>
                    <li>{% render 'icon-check' %}Everyday curry & marinade base</li>
                  </ul>
              {% endcase %}
              <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="btn btn--dark" style="--card-dark: {{ p_dark[i] }};">Shop Now</a>
            </div>
          {% endfor %}

          <div class="scroll-showcase__dots" role="tablist" aria-label="Products">
            {% for title in p_titles %}
              <button type="button" class="scroll-showcase__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Show {{ title }}"></button>
            {% endfor %}
          </div>
        </div>

        <div class="scroll-showcase__media">
          {% for title in p_titles %}
            {% assign i = forloop.index0 %}
            <div class="scroll-showcase__image-slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ i }}">
              <img src="{{ p_images[i] | asset_url }}" alt="{{ title | escape }}" loading="lazy" width="700" height="700">
            </div>
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scroll showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Pack" },
    { "type": "url", "id": "shop_all_link", "label": "\"Shop Now\" link (all buttons)" }
  ]
}
{% endschema %}
