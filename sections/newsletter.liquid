<section class="newsletter">
  <div class="page-width newsletter__inner">
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="newsletter__text">{{ section.settings.text }}</p>
    {% form 'customer', id: 'NewsletterForm' %}
      {% if form.posted_successfully? %}
        <p class="newsletter__success">Thanks — welcome to the pack! 🦖</p>
      {% else %}
        <div class="newsletter__form">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Your email address" required class="newsletter__input" aria-label="Email address">
          <button type="submit" class="btn btn--solid">Join the Pack</button>
        </div>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't Miss a Bite" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New flavours, spicy drops and dinosaur-sized discounts — straight to your inbox." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
