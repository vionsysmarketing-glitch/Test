{% comment %} Hardcoded — see scroll-showcase.liquid for why. {% endcomment %}
<section class="how-it-works">
  <div class="how-it-works__heading-area">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="how-it-works__content-area" style="background-color: {{ section.settings.band_color }};">
    <div class="how-it-works__grid">
      <div class="how-it-works__step">
        <div class="how-it-works__icon-circle" style="background-color: {{ section.settings.icon_circle_color }};">
          <span aria-hidden="true">🫙</span>
        </div>
        <p class="how-it-works__step-text">Twist open the jar — no cooking, no prep needed.</p>
      </div>
      <div class="how-it-works__step">
        <div class="how-it-works__icon-circle" style="background-color: {{ section.settings.icon_circle_color }};">
          <span aria-hidden="true">🥄</span>
        </div>
        <p class="how-it-works__step-text">Spoon out as much heat as you can handle.</p>
      </div>
      <div class="how-it-works__step">
        <div class="how-it-works__icon-circle" style="background-color: {{ section.settings.icon_circle_color }};">
          <span aria-hidden="true">🌯</span>
        </div>
        <p class="how-it-works__step-text">Pair with snacks, wraps, rice, eggs or momos.</p>
      </div>
      <div class="how-it-works__step">
        <div class="how-it-works__icon-circle" style="background-color: {{ section.settings.icon_circle_color }};">
          <span aria-hidden="true">🔥</span>
        </div>
        <p class="how-it-works__step-text">Reseal and refrigerate. Bold flavour, zero waste.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready in Seconds. Bold for Hours." },
    { "type": "color", "id": "band_color", "label": "Band background", "default": "#F7C2B8" },
    { "type": "color", "id": "icon_circle_color", "label": "Icon circle color", "default": "#9D0101" }
  ]
}
{% endschema %}
