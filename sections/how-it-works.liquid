<section class="how-it-works">
  <div class="page-width">
    <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
    <div class="how-it-works__steps">
      {% for block in section.blocks %}
        <div class="how-it-works__step" {{ block.shopify_attributes }}>
          <span class="how-it-works__step-number">{{ forloop.index }}</span>
          <h3 class="how-it-works__step-title">{{ block.settings.title }}</h3>
          <p class="how-it-works__step-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Snack Bold in 3 Steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Pick your flavour", "text": "Ghost, Imli, Momo, Devil or Hummus — choose your heat level." } },
      { "type": "step", "settings": { "title": "Open the jar", "text": "No cooking, no prep. It's ready to eat straight away." } },
      { "type": "step", "settings": { "title": "Pair & devour", "text": "Snacks, wraps, rice, eggs — one jar, endless combos." } }
    ]
  },
  "presets": [
    { "name": "How it works" }
  ]
}
{% endschema %}
