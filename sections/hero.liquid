<section class="hero" style="--hero-bg-left: {{ section.settings.color_left }}; --hero-bg-right: {{ section.settings.color_right }};">
  <div class="hero__half hero__half--left">
    <div class="hero__leaf-badge">
      <span aria-hidden="true">🌶️</span> {{ section.settings.eyebrow }}
    </div>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__subtitle">{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      <a href="{{ section.settings.primary_link }}" class="btn btn--solid">{{ section.settings.primary_label }}</a>
      <a href="{{ section.settings.secondary_link }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>
    </div>

    <div class="hero__swatches" role="list" aria-label="Flavours">
      {% for block in section.blocks %}
        {% case block.settings.label %}
          {% when 'Ghost' %}{% assign fallback = 'ghost-chutney.jpg' %}
          {% when 'Imli' %}{% assign fallback = 'imli-chutney.jpg' %}
          {% when 'Momo' %}{% assign fallback = 'momo-chutney.jpg' %}
          {% when 'Chilli' %}{% assign fallback = 'chilli-flakes.jpg' %}
          {% when 'Masala' %}{% assign fallback = 'garam-masala.jpg' %}
          {% else %}{% assign fallback = 'ghost-chutney.jpg' %}
        {% endcase %}
        <a href="{{ block.settings.link | default: '#' }}" class="hero__swatch" role="listitem" {{ block.shopify_attributes }}>
          <span class="hero__swatch-dot">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 80 }}" alt="{{ block.settings.label }}" width="34" height="34" loading="lazy">
            {% else %}
              <img src="{{ fallback | asset_url }}" alt="{{ block.settings.label }}" width="34" height="34" loading="lazy">
            {% endif %}
          </span>
          <span class="hero__swatch-label">{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>

  <div class="hero__half hero__half--right">
    <div class="hero__image-card">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" width="900" height="900">
      {% else %}
        <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="Hungry Dinosaur Foods — Ghost, Imli & Momo Chutney" loading="eager" width="900" height="900">
      {% endif %}
      <div class="hero__badge-sale">{{ section.settings.badge_text }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch. Big flavour." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bold Flavour. Zero Boring." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homemade-style chutneys, dips & spices made with hyperlocal Indian ingredients and a bold global twist. Ready to eat, impossible to put down." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Pack" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Defaults to the Hungry Dinosaur product banner" },
    { "type": "text", "id": "badge_text", "label": "Corner badge text", "default": "New Batch" },
    { "type": "color", "id": "color_left", "label": "Left panel color", "default": "#FBEADF" },
    { "type": "color", "id": "color_right", "label": "Right panel color", "default": "#9D0101" }
  ],
  "blocks": [
    {
      "type": "swatch",
      "name": "Flavour swatch",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ghost" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "swatch", "settings": { "label": "Ghost" } },
      { "type": "swatch", "settings": { "label": "Imli" } },
      { "type": "swatch", "settings": { "label": "Momo" } },
      { "type": "swatch", "settings": { "label": "Chilli" } },
      { "type": "swatch", "settings": { "label": "Masala" } }
    ]
  },
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
