{% assign heading_words = section.settings.heading | split: ' ' %}
{% assign heading_word_count = heading_words.size %}
{% assign heading_lead_count = heading_word_count | minus: 1 %}
{% assign heading_lead = heading_words | slice: 0, heading_lead_count | join: ' ' %}
{% assign heading_last = heading_words | last %}

<section class="hero" style="--hero-bg: {{ section.settings.background_color }}; --hero-stage-color: {{ section.settings.stage_color }}; --hero-stage-color-alt: {{ section.settings.stage_color_alt }};">
  <div class="hero__deco hero__deco--1" style="color: #FFFFFF;">{% render 'deco-chili' %}</div>
  <div class="hero__deco hero__deco--2" style="color: #FFE8CF;">{% render 'deco-leaf-branch' %}</div>
  <div class="hero__deco hero__deco--3" style="color: #FFFFFF;">{% render 'deco-tamarind' %}</div>

  <div class="hero__half hero__half--left">
    <div class="hero__watermark" aria-hidden="true">{% render 'deco-swirl' %}</div>

    <div class="hero__leaf-badge">
      <span aria-hidden="true">🌶️</span> {{ section.settings.eyebrow }}
    </div>
    <h1 class="hero__title hero__title--compact">{{ heading_lead }} <span class="hero__title-accent">{{ heading_last }}</span></h1>

    {% comment %} Hardcoded — see scroll-showcase.liquid for why. {% endcomment %}
    <div class="hero__features">
      <div class="hero__feature">
        <span class="hero__feature-icon" style="--feature-color: #4A6B1F;">{% render 'icon-leaf' %}</span>
        <span class="hero__feature-label">Natural Ingredients</span>
      </div>
      <div class="hero__feature">
        <span class="hero__feature-icon" style="--feature-color: #014C9D;">{% render 'icon-shield' %}</span>
        <span class="hero__feature-label">Zero Preservatives</span>
      </div>
      <div class="hero__feature">
        <span class="hero__feature-icon" style="--feature-color: #9D0101;">{% render 'icon-flame' %}</span>
        <span class="hero__feature-label">Small-Batch Made</span>
      </div>
      <div class="hero__feature">
        <span class="hero__feature-icon" style="--feature-color: #B5651D;">{% render 'icon-truck' %}</span>
        <span class="hero__feature-label">Free Shipping</span>
      </div>
    </div>

    <div class="hero__actions">
      <a href="{{ section.settings.primary_link }}" class="btn btn--solid">{{ section.settings.primary_label }}</a>
      <a href="{{ section.settings.secondary_link }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>
    </div>
  </div>

  <div class="hero__half hero__half--right">
    <div class="hero__stage" aria-hidden="true"></div>
    <div class="hero__deco hero__deco--4" style="color: #FFE8CF;">{% render 'deco-swirl' %}</div>
    <div class="hero__deco hero__deco--5" style="color: #FFE8CF;">{% render 'deco-chili' %}</div>
    <div class="hero__deco hero__deco--6" style="color: #FFE8CF;">{% render 'deco-leaf-branch' %}</div>

    {% comment %}
      Only the three "clean" product photos (plain white studio background)
      are used here — the chutney jars are shot with a grey lifestyle
      backdrop that shows as a visible mismatched box inside a circular
      badge, so they're kept out of this cluster.
    {% endcomment %}
    <div class="hero__product-cluster">
      <a href="{{ section.settings.masala_link | default: '/products/garam-masala-powder' }}" class="hero__spotlight-float">
        <span class="hero__spotlight-badge">⭐ Best Seller</span>
        <img src="{{ 'garam-masala.jpg' | asset_url }}" alt="Garam Masala Powder" loading="eager" width="300" height="300">
        <span class="hero__spotlight-title">Garam Masala Powder</span>
      </a>
      <a href="{{ section.settings.chilli_link | default: '/products/chilli-flakes' }}" class="hero__orbit hero__orbit--chilli">
        <img src="{{ 'chilli-flakes.jpg' | asset_url }}" alt="Chilli Flakes" loading="lazy" width="150" height="150">
        <span>Chilli Flakes</span>
      </a>
      <a href="{{ section.settings.coriander_link | default: '/products/coriander-powder' }}" class="hero__orbit hero__orbit--coriander">
        <img src="{{ 'coriander-powder.jpg' | asset_url }}" alt="Dhaniya Powder" loading="lazy" width="150" height="150">
        <span>Dhaniya Powder</span>
      </a>
    </div>

    <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__range-pill">
      {{ section.settings.range_label }} <span aria-hidden="true">→</span>
    </a>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,0 C240,50 480,10 720,32 C960,54 1200,15 1440,40 L1440,60 L0,60 Z" fill="{{ section.settings.wave_color | default: '#FBF3E7' }}"></path>
  </svg>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch. Big flavour." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bold Flavour. Zero Boring." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Pack" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "range_label", "label": "CTA card text", "default": "Shop the Full Range" },
    { "type": "color", "id": "background_color", "label": "Left panel color", "default": "#014C9D", "info": "Bold flat color behind the headline — pairs with the orange product panel for a strong duotone" },
    { "type": "color", "id": "stage_color", "label": "Product panel accent color", "default": "#FF5A36", "info": "The bold color block behind the floating products" },
    { "type": "color", "id": "stage_color_alt", "label": "Product panel sunburst color", "default": "#FFC93C", "info": "The second color used for the sunburst rays behind the hero product" },
    { "type": "color", "id": "wave_color", "label": "Bottom wave color", "default": "#FBF3E7", "info": "Should match the page background so the section blends in on scroll" },
    { "type": "url", "id": "shop_all_link", "label": "\"Shop the Full Range\" link" },
    { "type": "header", "content": "Product links" },
    { "type": "url", "id": "masala_link", "label": "Garam Masala Powder link", "info": "Defaults to /products/garam-masala-powder" },
    { "type": "url", "id": "chilli_link", "label": "Chilli Flakes link", "info": "Defaults to /products/chilli-flakes" },
    { "type": "url", "id": "coriander_link", "label": "Dhaniya Powder link", "info": "Defaults to /products/coriander-powder" }
  ]
}
{% endschema %}
