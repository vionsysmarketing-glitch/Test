{% comment %}
  Accents the last two words of the heading (not just one) so a phrase
  like "Real Flavour" can be highlighted as a unit rather than only its
  final word — falls back to accenting just the last word if the heading
  is shorter than 2 words.
{% endcomment %}
{% assign heading_words = section.settings.heading | split: ' ' %}
{% assign heading_word_count = heading_words.size %}
{% assign heading_accent_words = 2 %}
{% if heading_word_count < 2 %}
  {% assign heading_accent_words = 1 %}
{% endif %}
{% assign heading_lead_count = heading_word_count | minus: heading_accent_words %}
{% assign heading_lead = heading_words | slice: 0, heading_lead_count | join: ' ' %}
{% assign heading_last = heading_words | slice: heading_lead_count, heading_accent_words | join: ' ' %}

<section class="hero" style="--hero-bg: {{ section.settings.background_color }};">
  {% comment %}
    Rebuilt after the Cien Chiles reference: a light ground with dense
    flat-vector chilli/botanical clusters growing in from the left and
    right edges, framing a centred display headline and a short line of
    copy. The illustration is the whole visual idea here, so the previous
    sticker collage, mascot, scrolling ticker and stripe backdrop are all
    gone — they'd fight the artwork for attention.

    No product photograph: the reference frames type, not a bottle, and
    dropping the jar in between two dense clusters either crowded the art
    or got clipped by them at narrower widths.
  {% endcomment %}
  <div class="hero__garden hero__garden--left" aria-hidden="true">{% render 'deco-chili-cluster-a' %}</div>
  <div class="hero__garden hero__garden--right" aria-hidden="true">{% render 'deco-chili-cluster-b' %}</div>

  <div class="hero__inner page-width">
    <div class="hero__content">
      <span class="hero__swoosh" aria-hidden="true">{% render 'icon-chili-swoosh' %}</span>

      <h1 class="hero__title">
        <span class="hero__title-lead">{{ heading_lead }}</span>
        <span class="hero__title-accent">{{ heading_last }}<svg class="hero__title-underline" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2,8 C40,2 90,12 130,6 C160,2 180,10 198,5"></path></svg></span>
      </h1>

      {% if section.settings.subheading != blank %}
        <p class="hero__subtext">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="hero__actions">
        <a href="{{ section.settings.primary_link }}" class="btn btn--solid">{{ section.settings.primary_label }}</a>
        <a href="{{ section.settings.secondary_link }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>
        <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__range-link">
          {{ section.settings.range_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,0 C240,50 480,10 720,32 C960,54 1200,15 1440,40 L1440,60 L0,60 Z" fill="{{ section.settings.wave_color | default: '#FBF3E7' }}"></path>
  </svg>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing Beats Real Flavour" },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading", "default": "Small-batch chutneys and export-quality spice powders, made with nothing but real ingredients. No preservatives, no shortcuts." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Pack" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "range_label", "label": "CTA card text", "default": "Shop the Full Range" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FBF3E7", "info": "Light ground the chilli illustrations sit on" },
    { "type": "color", "id": "wave_color", "label": "Bottom wave color", "default": "#FBF3E7", "info": "Should match the page background so the section blends in on scroll" },
    { "type": "url", "id": "shop_all_link", "label": "\"Shop the Full Range\" link" }
  ]
}
{% endschema %}
