<section class="hero" style="--hero-bg-left: {{ section.settings.color_left }}; --hero-bg-right: {{ section.settings.color_right }};">
  <div class="hero__half hero__half--left">
    <div class="hero__leaf-badge">
      <span aria-hidden="true">🌶️</span> {{ section.settings.eyebrow }}
    </div>
    <h1 class="hero__title hero__title--compact">{{ section.settings.heading }}</h1>
    <p class="hero__subtitle">{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      <a href="{{ section.settings.primary_link }}" class="btn btn--solid">{{ section.settings.primary_label }}</a>
      <a href="{{ section.settings.secondary_link }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>
    </div>

    {% comment %} Hardcoded — see scroll-showcase.liquid for why. {% endcomment %}
    <div class="hero__swatches" role="list" aria-label="Flavours">
      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__swatch" role="listitem">
        <span class="hero__swatch-dot"><img src="{{ 'ghost-chutney.jpg' | asset_url }}" alt="Ghost" width="34" height="34" loading="lazy"></span>
        <span class="hero__swatch-label">Ghost</span>
      </a>
      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__swatch" role="listitem">
        <span class="hero__swatch-dot"><img src="{{ 'imli-chutney.jpg' | asset_url }}" alt="Imli" width="34" height="34" loading="lazy"></span>
        <span class="hero__swatch-label">Imli</span>
      </a>
      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__swatch" role="listitem">
        <span class="hero__swatch-dot"><img src="{{ 'momo-chutney.jpg' | asset_url }}" alt="Momo" width="34" height="34" loading="lazy"></span>
        <span class="hero__swatch-label">Momo</span>
      </a>
      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__swatch" role="listitem">
        <span class="hero__swatch-dot"><img src="{{ 'chilli-flakes.jpg' | asset_url }}" alt="Chilli" width="34" height="34" loading="lazy"></span>
        <span class="hero__swatch-label">Chilli</span>
      </a>
      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__swatch" role="listitem">
        <span class="hero__swatch-dot"><img src="{{ 'garam-masala.jpg' | asset_url }}" alt="Masala" width="34" height="34" loading="lazy"></span>
        <span class="hero__swatch-label">Masala</span>
      </a>
    </div>
  </div>

  <div class="hero__half hero__half--right">
    <div class="hero__range">
      <span class="hero__range-label">{{ section.settings.range_label }}</span>
      <div class="hero__range-grid">
        <div class="hero__range-card"><img src="{{ 'ghost-chutney.jpg' | asset_url }}" alt="Ghost Chutney" loading="eager" width="220" height="220"><span>Ghost Chutney</span></div>
        <div class="hero__range-card"><img src="{{ 'imli-chutney.jpg' | asset_url }}" alt="Imli Chutney" loading="eager" width="220" height="220"><span>Imli Chutney</span></div>
        <div class="hero__range-card"><img src="{{ 'momo-chutney.jpg' | asset_url }}" alt="Momo Chutney" loading="eager" width="220" height="220"><span>Momo Chutney</span></div>
        <div class="hero__range-card"><img src="{{ 'chilli-flakes.jpg' | asset_url }}" alt="Chilli Flakes" loading="lazy" width="220" height="220"><span>Chilli Flakes</span></div>
        <div class="hero__range-card"><img src="{{ 'garam-masala.jpg' | asset_url }}" alt="Garam Masala Powder" loading="lazy" width="220" height="220"><span>Garam Masala</span></div>
        <div class="hero__range-card"><img src="{{ 'coriander-powder.jpg' | asset_url }}" alt="Coriander Powder" loading="lazy" width="220" height="220"><span>Coriander Powder</span></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch. Big flavour." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bold Flavour. Zero Boring." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homemade-style chutneys, dips & spices made with hyperlocal Indian ingredients and a bold global twist. Ready to eat, impossible to put down." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Pack" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "range_label", "label": "Product range label", "default": "The Full Range" },
    { "type": "color", "id": "color_left", "label": "Left panel color", "default": "#FBEADF" },
    { "type": "color", "id": "color_right", "label": "Right panel color", "default": "#9D0101" },
    { "type": "url", "id": "shop_all_link", "label": "Flavour swatches link" }
  ]
}
{% endschema %}
