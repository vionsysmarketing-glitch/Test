{% comment %}
  Accents the last two words of the heading (not just one) so a phrase
  like "Real Flavour" can be highlighted as a unit rather than only its
  final word — falls back to accenting just the last word if the heading
  is shorter than 2 words.
{% endcomment %}
{% assign heading_words = section.settings.heading | split: ' ' %}
{% assign heading_word_count = heading_words.size %}
{% assign heading_accent_words = 2 %}
{% if heading_word_count < 2 %}
  {% assign heading_accent_words = 1 %}
{% endif %}
{% assign heading_lead_count = heading_word_count | minus: heading_accent_words %}
{% assign heading_lead = heading_words | slice: 0, heading_lead_count | join: ' ' %}
{% assign heading_last = heading_words | slice: heading_lead_count, heading_accent_words | join: ' ' %}

<section class="hero" style="--hero-bg: {{ section.settings.background_color }};">
  {% comment %}
    No product image anywhere in this section anymore — every attempt at
    isolating a product photo here kept reading as some version of "box
    around a product," so this drops the product entirely and rebuilds
    the section around a single centered column instead of a two-column
    text/product split. The sunburst + halftone texture from the brand's
    own marketing creatives (assets/hero-banner.jpg) stays, but now as a
    full-section backdrop behind the centered headline rather than
    confined to a small "product stage."
  {% endcomment %}
  <span class="hero__decor-burst" aria-hidden="true"></span>
  <span class="hero__decor-dots" aria-hidden="true"></span>
  <span class="hero__decor-sparkle hero__decor-sparkle--1" aria-hidden="true">{% render 'icon-sparkle' %}</span>
  <span class="hero__decor-sparkle hero__decor-sparkle--2" aria-hidden="true">{% render 'icon-sparkle' %}</span>
  <span class="hero__decor-sparkle hero__decor-sparkle--3" aria-hidden="true">{% render 'icon-sparkle' %}</span>

  <div class="hero__deco hero__deco--1" style="color: #FFFFFF; --deco-float-duration: 5.2s; --deco-float-delay: -2.6s;">{% render 'deco-chili' %}</div>
  <div class="hero__deco hero__deco--2" style="color: #FFE8CF; --deco-float-duration: 6.5s; --deco-float-delay: -0.9s;">{% render 'deco-leaf-branch' %}</div>
  <div class="hero__deco hero__deco--3" style="color: #FFFFFF; --deco-float-duration: 4.8s; --deco-float-delay: -3.9s;">{% render 'deco-tamarind' %}</div>
  <div class="hero__deco hero__deco--4" style="color: #FFFFFF; --deco-float-duration: 5.9s; --deco-float-delay: -1.8s;">{% render 'deco-swirl' %}</div>
  <div class="hero__deco hero__deco--6" style="color: #FFE8CF; --deco-float-duration: 5.1s; --deco-float-delay: -3.2s;">{% render 'deco-leaf-branch' %}</div>

  <div class="hero__inner page-width">
    <div class="hero__content">
      <div class="hero__left-ring" aria-hidden="true"></div>
      <div class="hero__watermark" aria-hidden="true">{% render 'deco-swirl' %}</div>
      <div class="hero__deco hero__deco--7" style="color: #FFFFFF; --deco-float-duration: 5.5s; --deco-float-delay: -1.2s;">{% render 'deco-swirl' %}</div>
      <div class="hero__deco hero__deco--8" style="color: #FFE8CF; --deco-float-duration: 6.2s; --deco-float-delay: -3.4s;">{% render 'deco-chili' %}</div>
      <div class="hero__deco hero__deco--9" style="color: #FFFFFF; --deco-float-duration: 4.6s; --deco-float-delay: -0.6s;">{% render 'deco-mortar-pestle' %}</div>
      <div class="hero__deco hero__deco--10" style="color: #FFE8CF; --deco-float-duration: 5.8s; --deco-float-delay: -2.1s;">{% render 'deco-garlic' %}</div>

      <div class="hero__leaf-badge">
        <span aria-hidden="true">🌶️</span> {{ section.settings.eyebrow }}
      </div>
      <h1 class="hero__title hero__title--compact">{{ heading_lead }} <span class="hero__title-accent">{{ heading_last }}<svg class="hero__title-underline" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2,8 C40,2 90,12 130,6 C160,2 180,10 198,5"></path></svg></span></h1>

      {% comment %} Hardcoded — see scroll-showcase.liquid for why. {% endcomment %}
      <div class="hero__features">
        <div class="hero__feature">
          <span class="hero__feature-icon" style="--feature-color: #4A6B1F;">{% render 'icon-leaf' %}</span>
          <span class="hero__feature-label">Natural Ingredients</span>
        </div>
        <div class="hero__feature">
          <span class="hero__feature-icon" style="--feature-color: #014C9D;">{% render 'icon-shield' %}</span>
          <span class="hero__feature-label">Zero Preservatives</span>
        </div>
        <div class="hero__feature">
          <span class="hero__feature-icon" style="--feature-color: #9D0101;">{% render 'icon-flame' %}</span>
          <span class="hero__feature-label">Small-Batch Made</span>
        </div>
        <div class="hero__feature">
          <span class="hero__feature-icon" style="--feature-color: #B5651D;">{% render 'icon-truck' %}</span>
          <span class="hero__feature-label">Free Shipping</span>
        </div>
      </div>

      <div class="hero__actions">
        <a href="{{ section.settings.primary_link }}" class="btn btn--solid">{{ section.settings.primary_label }}</a>
        <a href="{{ section.settings.secondary_link }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>
      </div>

      <a href="{{ section.settings.shop_all_link | default: '/collections/all' }}" class="hero__range-pill">
        {{ section.settings.range_label }} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <svg class="hero__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,0 C240,50 480,10 720,32 C960,54 1200,15 1440,40 L1440,60 L0,60 Z" fill="{{ section.settings.wave_color | default: '#FBF3E7' }}"></path>
  </svg>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch. Big flavour." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing Beats Real Flavour" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the Pack" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our Story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "range_label", "label": "CTA card text", "default": "Shop the Full Range" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#E88B23", "info": "Bold flat color across the whole section" },
    { "type": "color", "id": "wave_color", "label": "Bottom wave color", "default": "#FBF3E7", "info": "Should match the page background so the section blends in on scroll" },
    { "type": "url", "id": "shop_all_link", "label": "\"Shop the Full Range\" link" }
  ]
}
{% endschema %}
